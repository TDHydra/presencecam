{
  "id": "ld2410",
  "name": "HLK-LD2410 / LD2410B / LD2410C 24 GHz radar",
  "short": "LD2410 radar",
  "bus": "uart",
  "supply": "5v",
  "presence": true,
  "description": "Detects people moving and sitting still, with distance. Same wiring for the LD2410, B and C; the pin order differs between them, so go by the labels printed on the module. Wire TX/RX for distance and signal strength, OUT for plain on/off; both is best.",
  "pins": [
    {"label": "VCC", "role": "vcc"},
    {"label": "GND", "role": "gnd"},
    {"label": "TX", "role": "uart_rx", "key": "rx", "group": "uart"},
    {"label": "RX", "role": "uart_tx", "key": "tx", "group": "uart"},
    {"label": "OUT", "role": "digital_in", "key": "out", "group": "out"}
  ],
  "groups": [
    {"id": "uart", "label": "TX/RX: distance and signal strength", "default": true},
    {"id": "out", "label": "OUT: presence on/off", "default": true}
  ],
  "readings": [{"key": "Radar", "label": "Radar (yes/no)"}, {"key": "Distance", "label": "Distance cm"}, {"key": "Moving", "label": "Moving energy %"}, {"key": "Still", "label": "Still energy %"}]
}
